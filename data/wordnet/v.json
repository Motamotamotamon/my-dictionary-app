{"vamp up":{"verb":[{"definition":"make up","example":"vamp up an excuse for not attending the meeting"},{"definition":"piece (something old) with a new part","example":"vamp up an old speech"}]},"vege out":{"verb":[{"definition":"engage in passive relaxation"}]},"view as":{"verb":[{"definition":"keep in mind or convey as a conviction or view","example":"view as important"}]},"vomit up":{"verb":[{"definition":"eject the contents of the stomach through the mouth"}]},"vote down":{"verb":[{"definition":"thwart the passage of"},{"definition":"vote against"}]},"vote in":{"verb":[{"definition":"elect in a voting process"}]},"vote out":{"verb":[{"definition":"thwart the passage of"}]},"very fast":{"adverb":[{"definition":"in a relatively short time"}]},"very loudly":{"adverb":[{"definition":"a direction in music; to be played very loudly"}]},"very much":{"adverb":[{"definition":"to a very great degree or extent","example":"we enjoyed ourselves very much"}]},"very much like":{"adverb":[{"definition":"in a similar way"}]},"very softly":{"adverb":[{"definition":"a direction in music; to be played very softly"}]},"very well":{"adverb":[{"definition":"quite well"},{"definition":"an expression of agreement normally occurring at the beginning of a sentence"}]},"vice versa":{"adverb":[{"definition":"with the order reversed","example":"she hates him and vice versa"}]},"viva voce":{"adverb":[{"definition":"orally","example":"I heard it viva voce"}]},"visually challenged":{"adjective":[{"definition":"having greatly reduced vision"}]},"visually impaired":{"adjective":[{"definition":"having greatly reduced vision"}]}}
